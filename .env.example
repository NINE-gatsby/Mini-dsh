# Set an actual provider URL, model ID and API key before running.
# Generic configuration; /anthropic endpoints select the Anthropic protocol.
APIKEY=your-api-key
API=https://your-provider.example/v1
MODEL=your-model-id

# Alternatively, remove the generic APIKEY/API entries and configure one provider:
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://your-provider.example/v1
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_BASE_URL=https://your-provider.example/anthropic

# Feedback-driven Skill extraction; background writes also require permissions.
BEAR_AUTO_SKILL_EVOLUTION=1
BEAR_AUTO_SKILL_TARGET=project
